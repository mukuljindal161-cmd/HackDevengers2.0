# RealityGraph Environment Configuration

# Database: Default to SQLite for zero-friction local run, or configure PostgreSQL with pgvector
DATABASE_URL=sqlite+aiosqlite:///./realitygraph.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/realitygraph

# AI Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004

# Security / Authentication
AUTH_SECRET=realitygraph_super_secret_jwt_key_hackathon_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Storage (Local path by default)
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=realitygraph-sources
